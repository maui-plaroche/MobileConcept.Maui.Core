<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Permissions ajoutées par le package au manifest mergé dans l'app consommatrice.
    Le <service> FcmAndroidService est généré automatiquement via les attributs
    [Service] + [IntentFilter] côté C#, donc pas besoin de le déclarer ici.
  -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
