<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <SingleProject>true</SingleProject>
        <UseMaui>true</UseMaui>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <!-- Métadonnées NuGet -->
        <Title>MobileConcept.Core</Title>
        <PackageId>MobileConcept.Core</PackageId>
        <Version>1.0.6</Version>
        <Authors>Paulin Laroche</Authors>
        <Company>Mobile Concept</Company>
        <Description>MobileConcept.Maui.Core provides essential utilities, base classes, and extension methods for .NET MAUI development. Includes common helpers for Android and iOS platforms, MVVM base classes, and reusable components to accelerate your mobile app development.</Description>
        <PackageTags>maui, dotnet, mobile, android, ios, core, utilities, cross-platform</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>© Mobile Concept. All rights reserved.</Copyright>
        <PackageProjectUrl>https://github.com/maui-plaroche/MobileConcept.Maui.Core</PackageProjectUrl>
        <RepositoryUrl>https://github.com/maui-plaroche/MobileConcept.Maui.Core.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <Product>$(AssemblyName) ($(TargetFramework))</Product>
        <PackageVersion>$(Version)$(VersionSuffix)</PackageVersion>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- Génération automatique du package -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

        <!-- Optionnel mais recommandé -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
       
        <NeutralLanguage>en</NeutralLanguage>

        <Configurations>Debug;Release</Configurations>
        
        <!-- Support des RIDs multiples -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>

        <!-- Fix for NuGet pack with multi-targeting -->
        <NoBuild>false</NoBuild>
        <IncludeBuildOutput>true</IncludeBuildOutput>
    </PropertyGroup>

    <!-- Si vous utilisez un README ou une icône -->
    <ItemGroup>
        <None Include="./../README.md" Pack="true" PackagePath="\" />
        <None Include="./../icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="SkiaSharp" Version="3.119.1" />
    </ItemGroup>
    
</Project>